{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly",
    ":semanticCommits"
  ],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "groupName": "aws-sdk-go",
      "matchManagers": ["gomod"],
      "matchPackagePrefixes": ["github.com/aws/"]
    },
    {
      "description": "Keep Go toolchain versions in mise and go.mod in sync",
      "matchManagers": ["mise", "gomod"],
      "matchDepNames": ["go"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "groupName": "go-toolchain",
      "minimumGroupSize": 2
    },
    {
      "groupName": "buildkite-plugins",
      "matchFileNames": [".buildkite/**"],
      "matchManagers": ["buildkite"]
    }
  ]
}
